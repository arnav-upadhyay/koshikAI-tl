   "id": "94be7b45",
   "metadata": {},
   "source": [
    "## Build combined states vector"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "f607edee",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Build combined state vector for this set\n",
    "y0_metab_output = y_steady_state[1:length(tags.idx)]                                        # All species without the codons\n",
    "y0_metab = y0_metab_output[1:end-5]                                                         # Species of the metabolite pool\n",
    "y0_output = y0_metab_output[end - 4: end]                                                   # Output species  \"RNA\" \"S70\"  \"rna\"  \"PRT\"  \"PTC\"\n",
    "ribosome_positions = [zeros(length(seqs[seq_name].Codon) - 1) for seq_name in seq_names]    # All codons per sequence \n",
    "output_sequences = reduce(vcat, ([y0_output; ribosome_positions[i]...] for i in eachindex(ribosome_positions))) # One set of output variables per sequence \n",
    "y0_all = vcat(y0_metab, output_sequences);                                                   # concatenate everything: metabolites pool, output 1, sequence 1, output 2, sequence 2, output 3, sequence 3 ..."
   ]
  },
  {
