    }
   ],
   "source": [
    "# Packages functions and data types --------\n",
    "include(\"packages.jl\") \n",
    "\n",
    "# initialization of data containers\n",
    "scale = txtl_types.init_scale()         # struct that makes it possible to influence rates by scaling them\n",
    "tags = txtl_types.init_data()           # data container saving everything necessary to start the ODE solver \n",
    "tags.growth_rate = 1                    # A growth rate (0.1 to 1.8) can be chosen and the proteins of the TXTL machinery will be tuned according to that growth rate and the processivity of the RNA polymerase\n",
    "\n",
    "\n",
    "\n",
    "## flags for efficiency factors\n",
    "positive_aminoacid          = true \n",
    "anti_shinedalgarno          = true      # If no hybridization file is available put flag to false. We apply the intaRNA program’s intarna function (q: aSD, t: sequence, SeedBP: 5, out: tMinE) to generate a hybridization profile along the sequence. Link to the website: https://rna.informatik.uni-freiburg.de/IntaRNA/Input.jsp;jsessionid=2AE257E91E7276283F22CD77A5A8AA03\n",
    "dynamic_efficiency          = true "
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6cddf8a4",
   "metadata": {},
   "source": [
    "## Function species and sequences"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "2c2f72ce",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "✅ Successfully loaded 1 sequences\n"
     ]
    }
   ],
   "source": [
    "# function species_and_sequences!\n",
    "sequence_path = joinpath(@__DIR__, \"..\", \"data\", \"sequences\")\n",
    "hybrid_path = joinpath(@__DIR__, \"..\", \"data\", \"sequences\",\"hybridization_files\")\n",
    "data_path = joinpath(@__DIR__, \"..\", \"data\", \"input\")\n",
    "seq_file = sequence_path * \"\\\\lacS.fa\"\n",
    "hyb_file = hybrid_path * \"\\\\lacS.txt\"\n",
    "\n",
    "\n",
    "\n",
    "seqs, seq_names = seqs_import_transcripts(seq_file) # Function that transforms DNA Sequence into mRNA, amino acids and codons\n",
    "\n",
    "hyb_files = [hyb_file]\n",
    "hyb_file_dict = Dict{String, String}()\n",
    "for (i, seq_name) in enumerate(seq_names)\n",
    "    hyb_file_dict[seq_name] = hyb_files[i]\n",
    "end\n",
    "tags.seq_names = seq_names\n",
    "tags.no_of_seqs = length(seq_names)\n",
    "\n",
    "if tags.growth_rate < 0.56\n",
    "    tags.avail_rib = -1.1191*tags.growth_rate^2 + 2.0385*tags.growth_rate + 0.1996; # calculate percentage of available ribosome, from Matamouros et al. 2021\n",
    "else\n",
    "    tags.avail_rib = 1.0 \n",
    "end\n",
    "\n",
    "# Starting conentrations \n",
    "\n",
    "data_path = joinpath(@__DIR__, \"..\", \"data\", \"input\")\n",
    "metab \t\t= DataFrame(CSV.File(data_path * \"\\\\metabolites.dat\", delim=';')) # contains model species with 3 letter tags\n",
    "amino \t\t= DataFrame(CSV.File(data_path * \"\\\\aminoacids.dat\", delim=';')) # AS long name, 3 letters, short form for aatRNAs and tRNAs\n",
    "codon_conc \t= DataFrame(CSV.File(data_path * \"\\\\Codons.dat\", delim=';')) # Contains codons and the relative binding strength of the cognate tRNA to them\n",
    "as_cod \t\t= DataFrame(CSV.File(data_path * \"\\\\AS_and_Codon.dat\", delim=';')) # tRNAs and codons they recognize\n",
    "T3_comp \t= DataFrame(CSV.File(data_path * \"\\\\T3_comp.dat\", delim=';')) # codons and their compatible tRNAs (can be one or two tRNAs)\n",
    "const_vars  = DataFrame(CSV.File(data_path * \"\\\\Constant_variables.dat\", delim=';')) # Tags of constant variables  \n",
    "        \n",
    "\n",
    "# Tag structure\n",
    "\n",
    "# Additional tags for model species \n",
    "species \t\t= [\"RNA\",\"S70\",\"rna\",\"PRT\",\"PTC\"]\n",
    "tags.Tag \t= [strip(s) for s in vcat(metab.Tag,species)] \n",
    "\n",
    "tags.Seq \t\t= seqs[seq_names[1]].Codon\n",
    "tags.Tagcell \t= metab.Tag\n",
    "tags.Name \t\t= metab.Name\n",
    "tags.cod \t\t= map(strip,codon_conc.cod)\n",
    "tags.efac \t\t= codon_conc.efac\n",
    "tags.as \t\t= as_cod.as\n",
    "tags.tRNAs \t\t= as_cod.tRNAas\n",
    "tags.codAS \t\t= as_cod.codAS # contains codons related to tRNAs\n",
    "tags.t3tRNA \t= T3_comp.t3tRNA\n",
    "tags.AA \t\t= amino.triple\n",
    "tags.Tag_constant_vars = const_vars.Tag\n",
    "\n",
    "tags.no_of_tRNAs = 38 # Model can be adjusted to organisms with different tRNA number. E. coli has 38\n",
    "tags.no_of_variables = length(tags.Name)\n",
    "\n",
    "# create_indices_struct!(tags, indices)\n",
    "\n",
    "indices_dictionary!(tags)\n",
    "\n"
   ]
  },
