# =============================
# Julia project .gitignore
# =============================

# --- Keep these under version control ---
#Project.toml

# ---- Ignore files ---------
Manifest.toml

# --- Ignore build artifacts, caches, etc. ---
*.jl.cov
*.jl.mem
*.ji
*.so
*.dylib
*.dll

# --- Ignore Jupyter / IJulia notebooks outputs ---
*.ipynb_checkpoints/

# --- Ignore data and generated files ---
*.csv
*.tsv
*.xlsx

# Keep this excel file:
!docs/01_Test_data_for_model_implementation.xlsx

*.png
*.jpg
*.jpeg
*.svg
*.gif
*.pdf

# --- Ignore logs and temporary files ---
*.log
*.tmp
*.bak
*.swp
.DS_Store
Thumbs.db

# --- Ignore Julia package environments (optional) ---
.julia/
deps/
scratch/
